# Copy to .env and replace every value. Never commit a real .env file or reuse these examples.
# Full reference: docs/CONFIGURATION.md

DATABASE_URL="postgresql://postgres:password@localhost:5432/canopyos"

# REQUIRED. The backend refuses to start without it.
# Generate one with:  openssl rand -hex 32
# In production it must be at least 32 characters and must not look like a placeholder.
JWT_SECRET="<generate-with-openssl-rand-hex-32>"

PORT=3001
# NODE_ENV=production

# Comma-separated list of EXACT frontend origins allowed by CORS (no wildcard, no path, no trailing slash).
# Optional in development (defaults to http://localhost:3000), REQUIRED when NODE_ENV=production.
# CORS_ORIGINS="https://app.example.com"

# Photo storage. REQUIRED in production: absolute path of a persistent, backed-up volume.
# Defaults to ./private-uploads in development.
# CANOPYOS_UPLOAD_DIR="/var/lib/canopyos/photos"
# PHOTOS_MAX_PER_PLANT=50

# Rate limit of /auth/register and /auth/login, per client address and per route.
# AUTH_RATE_LIMIT=10
# AUTH_RATE_WINDOW_SEC=60
# Number of reverse proxies in front of the backend (0-5). Needed so the limit sees the real client address.
# TRUST_PROXY_HOPS=0
